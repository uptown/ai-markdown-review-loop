{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uptown/ai-markdown-review-loop/blob/main/docs/review-task.schema.json",
  "title": "AI Markdown Review Loop task file v3",
  "description": "Canonical colocated agent task file. The runtime additionally checks unique item IDs and lineEnd >= line. Agents update only status, result and resultFor after saving Markdown, then may delete the file when the round is complete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "guidance",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "document": {
      "type": "string",
      "pattern": "^[^/\\\\\\u0000-\\u001f]*\\.[mM][dD]$",
      "description": "Markdown basename resolved relative to this JSON file."
    },
    "guidance": {
      "$ref": "#/$defs/nonblank"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "description": "Each item ID must be unique. Preserve items while the agent is processing the round."
    }
  },
  "$defs": {
    "nonblank": {
      "type": "string",
      "pattern": "\\S"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote"
      ],
      "properties": {
        "quote": {
          "$ref": "#/$defs/nonblank"
        },
        "line": {
          "$ref": "#/$defs/positiveInteger",
          "description": "One-based hint, not authorization to edit that line."
        },
        "lineEnd": {
          "$ref": "#/$defs/positiveInteger",
          "description": "Requires line and must not precede it; the runtime checks ordering."
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contextBefore": {
          "type": "string"
        },
        "contextAfter": {
          "type": "string"
        },
        "state": {
          "enum": [
            "missing",
            "ambiguous"
          ],
          "description": "Preserve this state; do not guess a replacement target."
        }
      },
      "dependentRequired": {
        "lineEnd": [
          "line"
        ]
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rev",
        "target",
        "comment",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rv_[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "rev": {
          "$ref": "#/$defs/positiveInteger"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "comment": {
          "$ref": "#/$defs/nonblank"
        },
        "status": {
          "enum": [
            "pending",
            "done",
            "blocked"
          ]
        },
        "result": {
          "type": "string",
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[^\\r\\n]*$"
            }
          ],
          "description": "One short line explaining the change, relevant decision, or blocker."
        },
        "resultFor": {
          "$ref": "#/$defs/positiveInteger",
          "description": "The rev actually handled. A different value is retained as a stale result, not current completion."
        }
      },
      "dependentRequired": {
        "result": [
          "resultFor"
        ],
        "resultFor": [
          "result"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "done",
                  "blocked"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "result",
              "resultFor"
            ]
          }
        }
      ]
    }
  }
}
