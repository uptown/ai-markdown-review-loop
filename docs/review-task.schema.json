{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uptown/ai-markdown-review-loop/blob/main/docs/review-task.schema.json",
  "title": "AI Markdown Review Loop task file v3",
  "description": "Current user-comment sidecar and portable copied JSON. Agents review current Markdown, preserve user fields, save changes and delete the JSON. Legacy result fields are accepted for migration, not displayed or required. The runtime additionally checks ID uniqueness, target ordering and context filename consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "guidance",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "document": {
      "type": "string",
      "pattern": "^[^/\\\\\\u0000-\\u001f]*\\.[mM][dD]$",
      "description": "Markdown basename resolved relative to this JSON file."
    },
    "guidance": {
      "$ref": "#/$defs/nonblank"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "description": "Each item ID must be unique. Preserve the current user comments while the agent is processing the round; do not add history or replies."
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceFolder",
        "path"
      ],
      "description": "Copied JSON only; canonical on-disk writes omit this transport context.",
      "properties": {
        "workspaceFolder": {
          "type": "string",
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\:\\u0000-\\u001f]+$"
            }
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001f]+(?:/[^/\\\\:\\u0000-\\u001f]+)*$",
          "description": "Relative POSIX path within the named workspace folder; no empty segments; basename must equal document (checked at runtime)."
        }
      }
    }
  },
  "$defs": {
    "nonblank": {
      "type": "string",
      "pattern": "\\S"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote"
      ],
      "properties": {
        "quote": {
          "$ref": "#/$defs/nonblank"
        },
        "line": {
          "$ref": "#/$defs/positiveInteger",
          "description": "One-based hint, not authorization to edit that line."
        },
        "lineEnd": {
          "$ref": "#/$defs/positiveInteger",
          "description": "Requires line and must not precede it; the runtime checks ordering."
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contextBefore": {
          "type": "string"
        },
        "contextAfter": {
          "type": "string"
        },
        "state": {
          "enum": [
            "missing",
            "ambiguous"
          ],
          "description": "The target could not be verified in the current document; do not guess or move the comment."
        }
      },
      "dependentRequired": {
        "lineEnd": [
          "line"
        ]
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rev",
        "target",
        "comment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rv_[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "rev": {
          "$ref": "#/$defs/positiveInteger"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "comment": {
          "$ref": "#/$defs/nonblank"
        },
        "result": {
          "type": "string",
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[^\\r\\n]*$"
            }
          ],
          "description": "Legacy compatibility only. Not displayed or requested in the current loop.",
          "deprecated": true
        },
        "resultFor": {
          "$ref": "#/$defs/positiveInteger",
          "description": "Legacy compatibility only; must match the associated result and not exceed rev.",
          "deprecated": true
        },
        "status": {
          "enum": [
            "pending",
            "done",
            "blocked"
          ],
          "deprecated": true,
          "description": "Legacy v3 input only. Current exports omit it and it does not control comment ownership."
        }
      },
      "dependentRequired": {
        "result": [
          "resultFor"
        ],
        "resultFor": [
          "result"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "done",
                  "blocked"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "result",
              "resultFor"
            ]
          }
        }
      ]
    }
  }
}
