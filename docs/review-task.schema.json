{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uptown/ai-markdown-review-loop/blob/main/docs/review-task.schema.json",
  "title": "AI Markdown Review Loop task file v3",
  "description": "Canonical colocated current-comment file. The runtime additionally checks unique item IDs and lineEnd >= line. Comments belong to the user; an agent may record an optional short outcome after saving Markdown, then delete the file when the round is complete. Older v3 status fields are accepted for migration but are not emitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "guidance",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "document": {
      "type": "string",
      "pattern": "^[^/\\\\\\u0000-\\u001f]*\\.[mM][dD]$",
      "description": "Markdown basename resolved relative to this JSON file."
    },
    "guidance": {
      "$ref": "#/$defs/nonblank"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "description": "Each item ID must be unique. Preserve the current user comments while the agent is processing the round; do not add history or replies."
    }
  },
  "$defs": {
    "nonblank": {
      "type": "string",
      "pattern": "\\S"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote"
      ],
      "properties": {
        "quote": {
          "$ref": "#/$defs/nonblank"
        },
        "line": {
          "$ref": "#/$defs/positiveInteger",
          "description": "One-based hint, not authorization to edit that line."
        },
        "lineEnd": {
          "$ref": "#/$defs/positiveInteger",
          "description": "Requires line and must not precede it; the runtime checks ordering."
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contextBefore": {
          "type": "string"
        },
        "contextAfter": {
          "type": "string"
        },
        "state": {
          "enum": [
            "missing",
            "ambiguous"
          ],
          "description": "The target could not be verified in the current document; do not guess or move the comment."
        }
      },
      "dependentRequired": {
        "lineEnd": [
          "line"
        ]
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rev",
        "target",
        "comment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rv_[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "rev": {
          "$ref": "#/$defs/positiveInteger"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "comment": {
          "$ref": "#/$defs/nonblank"
        },
        "result": {
          "type": "string",
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[^\\r\\n]*$"
            }
          ],
          "description": "Optional one-line note from the agent after reviewing this comment."
        },
        "resultFor": {
          "$ref": "#/$defs/positiveInteger",
          "description": "The comment revision the optional result describes."
        }
      },
      "dependentRequired": {
        "result": [
          "resultFor"
        ],
        "resultFor": [
          "result"
        ]
      }
    }
  }
}
