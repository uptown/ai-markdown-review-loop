{
  "name": "ai-markdown-review-loop",
  "displayName": "AI Markdown Review Loop",
  "description": "Review Markdown with inline feedback, AI-ready threads, and agent handoff exports.",
  "version": "0.0.8",
  "publisher": "uptown",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uptown/ai-markdown-review-loop.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "review",
    "comments",
    "ai",
    "agent",
    "mcp"
  ],
  "activationEvents": [
    "onCustomEditor:aiMarkdownReviewLoop.reviewEditor",
    "onLanguage:markdown",
    "onCommand:aiMarkdownReviewLoop.openReviewPreview",
    "onCommand:aiMarkdownReviewLoop.openReviewBeside",
    "onCommand:aiMarkdownReviewLoop.reviewDocument",
    "onCommand:aiMarkdownReviewLoop.exportFeedback",
    "onCommand:aiMarkdownReviewLoop.openContextBootstrapPrompt",
    "onCommand:aiMarkdownReviewLoop.openFeedbackLoopPrompt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiMarkdownReviewLoop.openReviewBeside",
        "title": "AI Markdown Review: Open Review Beside",
        "icon": {
          "light": "media/split-review-icon.svg",
          "dark": "media/split-review-icon.svg"
        }
      },
      {
        "command": "aiMarkdownReviewLoop.openReviewPreview",
        "title": "AI Markdown Review: Open Review Preview",
        "icon": {
          "light": "media/review-icon.svg",
          "dark": "media/review-icon.svg"
        }
      },
      {
        "command": "aiMarkdownReviewLoop.reviewDocument",
        "title": "AI Markdown Review: Review Document"
      },
      {
        "command": "aiMarkdownReviewLoop.exportFeedback",
        "title": "AI Markdown Review: Export Feedback for Agent"
      },
      {
        "command": "aiMarkdownReviewLoop.openContextBootstrapPrompt",
        "title": "AI Markdown Review: Open AI Context Bootstrap Prompt"
      },
      {
        "command": "aiMarkdownReviewLoop.openFeedbackLoopPrompt",
        "title": "AI Markdown Review: Open AI Feedback Loop Prompt"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aiMarkdownReviewLoop.openReviewBeside",
          "when": "resourceExtname == .md || resourceLangId == markdown || activeEditor == aiMarkdownReviewLoop.reviewEditor",
          "group": "navigation@-11"
        },
        {
          "command": "aiMarkdownReviewLoop.openReviewPreview",
          "when": "resourceExtname == .md || resourceLangId == markdown || activeEditor == aiMarkdownReviewLoop.reviewEditor",
          "group": "navigation@-10"
        }
      ],
      "editor/title/context": [
        {
          "command": "aiMarkdownReviewLoop.openReviewBeside",
          "group": "navigation@-1"
        },
        {
          "command": "aiMarkdownReviewLoop.openReviewPreview",
          "group": "navigation@0"
        },
        {
          "command": "aiMarkdownReviewLoop.reviewDocument",
          "when": "resourceExtname == .md || resourceLangId == markdown || activeEditor == aiMarkdownReviewLoop.reviewEditor",
          "group": "navigation@1"
        },
        {
          "command": "aiMarkdownReviewLoop.exportFeedback",
          "when": "resourceExtname == .md || resourceLangId == markdown || activeEditor == aiMarkdownReviewLoop.reviewEditor",
          "group": "navigation@2"
        },
        {
          "command": "aiMarkdownReviewLoop.openContextBootstrapPrompt",
          "when": "resourceExtname == .md || resourceLangId == markdown || activeEditor == aiMarkdownReviewLoop.reviewEditor",
          "group": "navigation@3"
        },
        {
          "command": "aiMarkdownReviewLoop.openFeedbackLoopPrompt",
          "when": "resourceExtname == .md || resourceLangId == markdown || activeEditor == aiMarkdownReviewLoop.reviewEditor",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "aiMarkdownReviewLoop.openReviewBeside",
          "when": "resourceExtname == .md || resourceLangId == markdown",
          "group": "navigation@0"
        },
        {
          "command": "aiMarkdownReviewLoop.openReviewPreview",
          "when": "resourceExtname == .md || resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "aiMarkdownReviewLoop.reviewDocument",
          "when": "resourceExtname == .md || resourceLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "aiMarkdownReviewLoop.exportFeedback",
          "when": "resourceExtname == .md || resourceLangId == markdown",
          "group": "navigation@3"
        },
        {
          "command": "aiMarkdownReviewLoop.openContextBootstrapPrompt",
          "when": "resourceExtname == .md || resourceLangId == markdown",
          "group": "navigation@4"
        },
        {
          "command": "aiMarkdownReviewLoop.openFeedbackLoopPrompt",
          "when": "resourceExtname == .md || resourceLangId == markdown",
          "group": "navigation@5"
        }
      ],
      "explorer/context": [
        {
          "command": "aiMarkdownReviewLoop.openReviewBeside",
          "when": "resourceExtname == .md",
          "group": "navigation@0"
        },
        {
          "command": "aiMarkdownReviewLoop.openReviewPreview",
          "when": "resourceExtname == .md",
          "group": "navigation@1"
        },
        {
          "command": "aiMarkdownReviewLoop.reviewDocument",
          "when": "resourceExtname == .md",
          "group": "navigation@2"
        },
        {
          "command": "aiMarkdownReviewLoop.exportFeedback",
          "when": "resourceExtname == .md",
          "group": "navigation@3"
        },
        {
          "command": "aiMarkdownReviewLoop.openContextBootstrapPrompt",
          "when": "resourceExtname == .md",
          "group": "navigation@4"
        },
        {
          "command": "aiMarkdownReviewLoop.openFeedbackLoopPrompt",
          "when": "resourceExtname == .md",
          "group": "navigation@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiMarkdownReviewLoop.openReviewBeside",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorLangId == markdown"
      },
      {
        "command": "aiMarkdownReviewLoop.openReviewPreview",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == markdown"
      }
    ],
    "customEditors": [
      {
        "viewType": "aiMarkdownReviewLoop.reviewEditor",
        "displayName": "AI Markdown Review",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "AI Markdown Review Loop",
      "properties": {
        "aiMarkdownReviewLoop.storageMode": {
          "type": "string",
          "enum": [
            "colocated"
          ],
          "default": "colocated",
          "description": "Where review thread data is stored. Review state is stored beside each Markdown file in a hidden .<filename>.ai-review.json sidecar. Legacy workspace .ai-markdown-review sidecars are still read for migration."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=out/extension.js && node scripts/copy-vendor.mjs",
    "watch": "tsc -watch -p ./",
    "check": "tsc -p ./ --noEmit && npm run test:unit",
    "test": "npm run check",
    "test:unit": "tsc -p tsconfig.test.json && node --test .test-out/test",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "mermaid": "^11.15.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.25",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  }
}
